function FindDecomp(const AEntries: array of TDecompEntry; ACP: LongWord; out AStart: LongInt; out ALen: Byte): Boolean;
var lo, hi, mid: Integer;
begin
  lo := 0; hi := High(AEntries);
  while lo <= hi do
  begin
    mid := (lo + hi) div 2;
    if AEntries[mid].CP = ACP then
    begin
      AStart := AEntries[mid].Start; ALen := AEntries[mid].Len; Exit(True);
    end
    else if AEntries[mid].CP < ACP then lo := mid + 1
    else hi := mid - 1;
  end;
  Result := False;
end;

function CombiningClass(ACP: LongWord): Byte;
var lo, hi, mid: Integer;
begin
  lo := 0; hi := High(CCCEntries);
  while lo <= hi do
  begin
    mid := (lo + hi) div 2;
    if CCCEntries[mid].CP = ACP then Exit(CCCEntries[mid].CCC)
    else if CCCEntries[mid].CP < ACP then lo := mid + 1
    else hi := mid - 1;
  end;
  Result := 0;
end;

function ComposePair(A, B: LongWord; out ACP: LongWord): Boolean;
var lo, hi, mid: Integer;
begin
  { Hangul composition is algorithmic. }
  if (A >= $1100) and (A <= $1112) and (B >= $1161) and (B <= $1175) then
  begin
    ACP := $AC00 + ((A - $1100) * 21 + (B - $1161)) * 28; Exit(True);
  end;
  if (A >= $AC00) and (A <= $D7A3) and ((A - $AC00) mod 28 = 0) and
     (B >= $11A8) and (B <= $11C2) then
  begin
    ACP := A + (B - $11A7); Exit(True);
  end;
  lo := 0; hi := High(ComposeEntries);
  while lo <= hi do
  begin
    mid := (lo + hi) div 2;
    if (ComposeEntries[mid].A = A) and (ComposeEntries[mid].B = B) then
    begin
      ACP := ComposeEntries[mid].CP; Exit(True);
    end
    else if (ComposeEntries[mid].A < A) or ((ComposeEntries[mid].A = A) and (ComposeEntries[mid].B < B)) then
      lo := mid + 1
    else hi := mid - 1;
  end;
  Result := False;
end;

procedure DecomposeChar(ACP: LongWord; ACompat: Boolean; var AOut: array of LongWord; var ACount: Integer);
var st: LongInt; ln: Byte; i: Integer;
begin
  if (ACP >= $AC00) and (ACP <= $D7A3) then
  begin
    ACP := ACP - $AC00;
    AOut[ACount] := $1100 + (ACP div 588); Inc(ACount);
    AOut[ACount] := $1161 + ((ACP mod 588) div 28); Inc(ACount);
    if (ACP mod 28) <> 0 then
    begin
      AOut[ACount] := $11A7 + (ACP mod 28); Inc(ACount);
    end;
    Exit;
  end;
  if ACompat then
  begin
    if FindDecomp(CompatDecomp, ACP, st, ln) then
    begin
      for i := 0 to ln - 1 do DecomposeChar(CompatParts[st+i], True, AOut, ACount);
      Exit;
    end;
  end;
  if FindDecomp(CanonDecomp, ACP, st, ln) then
  begin
    for i := 0 to ln - 1 do DecomposeChar(CanonParts[st+i], ACompat, AOut, ACount);
    Exit;
  end;
  AOut[ACount] := ACP; Inc(ACount);
end;

function FloriaJSUnicodeNormalize(const AText: string; AForm: TFloriaJSUnicodeForm): string;
var
  src: UnicodeString;
  cps: array of LongWord;
  n, i, j, k, count, lastStarter: Integer;
  lastCCC: Byte;
  tmp: LongWord;
  ccc1, ccc2: Byte;
  composed: LongWord;
  compat: Boolean;
begin
  src := UTF8Decode(AText);
  SetLength(cps, Length(src) * 4 + 8);
  count := 0;
  compat := AForm in [ufNFKC, ufNFKD];
  for i := 1 to Length(src) do
    DecomposeChar(LongWord(Ord(src[i])), compat, cps, count);
  { canonical ordering }
  i := 0;
  while i < count do
  begin
    ccc1 := CombiningClass(cps[i]);
    if ccc1 = 0 then begin Inc(i); Continue; end;
    j := i;
    while (j > 0) and (CombiningClass(cps[j-1]) > ccc1) do
    begin
      tmp := cps[j]; cps[j] := cps[j-1]; cps[j-1] := tmp;
      Dec(j);
    end;
    Inc(i);
  end;
  if AForm in [ufNFC, ufNFKC] then
  begin
    i := 0; k := 0; lastStarter := -1; lastCCC := 0;
    while i < count do
    begin
      ccc1 := CombiningClass(cps[i]);
      if (lastStarter >= 0) and ((lastCCC = 0) or (lastCCC < ccc1)) and
         ComposePair(cps[lastStarter], cps[i], composed) then
      begin
        cps[lastStarter] := composed;
      end
      else
      begin
        if ccc1 = 0 then
        begin
          lastStarter := k;
          lastCCC := 0;
        end
        else
          lastCCC := ccc1;
        cps[k] := cps[i];
        Inc(k);
      end;
      Inc(i);
    end;
    count := k;
  end;
  SetLength(src, count);
  for i := 0 to count - 1 do src[i+1] := WideChar(cps[i]);
  Result := UTF8Encode(src);
end;

function FloriaJSUnicodeCompare(const ALeft, ARight: string): Integer;
var l, r: string;
begin
  l := FloriaJSUnicodeNormalize(ALeft, ufNFD);
  r := FloriaJSUnicodeNormalize(ARight, ufNFD);
  if l < r then Result := -1
  else if l > r then Result := 1
  else Result := 0;
end;

